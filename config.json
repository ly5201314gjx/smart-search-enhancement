{
  "skill": {
    "name": "增强搜索",
    "version": "1.0.0",
    "author": "AI Assistant",
    "description": "AI智能搜索引擎增强技能",
    "category": ["search", "ai", "nlp"],
    "tags": ["search", "AI", "summarization", "classification", "intent-recognition"]
  },
  "algorithms": {
    "intent_classifier": {"version": "1.0", "model": "weighted_logistic_regression", "feature_dim": 12},
    "result_aggregator": {"version": "1.0", "dedup_method": "simhash_64bit", "simhash_threshold": 0.85},
    "summarizer": {"version": "1.0", "method": "textrank_extractive", "damping_factor": 0.85},
    "auto_classifier": {"version": "1.0", "categories": ["News", "Official", "Forum", "Social", "Blog", "Video", "Academic", "Shopping"]},
    "quality_scorer": {"version": "1.0", "thresholds": {"excellent": 80, "standard": 60, "low_quality": 40}},
    "suggestion_engine": {"version": "1.0", "top_k": 5},
    "cross_lang_expander": {"version": "1.0", "bridge_languages": ["zh", "en", "ja", "ko"]},
    "performance_optimizer": {"version": "1.0", "timeouts": {"RealTime": 5, "default": 10, "Academic": 30}},
    "feedback_learner": {"version": "1.0", "learning_rate": 0.01}
  },
  "dependencies": {
    "required_packages": ["various_search", "google_search", "duckduckgo", "tavily", "extended_http_tools", "code_runner"]
  }
}
